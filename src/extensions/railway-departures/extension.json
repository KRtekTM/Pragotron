{
  "schema": 2,
  "id": "TabuleSprZel",
  "name": "Tabule SprŽel",
  "version": "1.0.0",
  "description": "Scrapuje odjezdy vlaků z webu Správy Železnic a zobrazuje je v panelu souborového systému Salamanderu.",
  "runtime": "JavaScript.Node",
  "entryPoint": "main.mjs",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "yes",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": ["file-system", "ui.dialogs", "storage"],
  "viewers": [{
    "name": "Detaily odjezdu vlaků",
    "patterns": ["*.departure"],
    "handler": "viewDeparture"
  }],
  "events": [],
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json"
  },
  "commands": [{
    "id": "TabuleSprZel.open",
    "title": "Otevřít vlakové odjezdy",
    "handler": "openDepartures",
    "menu": "both",
    "contextMenu": true,
    "toolbar": true,
    "requires": "any"
  },
  {
    "id": "TabuleSprZel.configure",
    "title": "Konfigurace",
    "handler": "configureUrl",
    "menu": "both",
    "contextMenu": false,
    "toolbar": false,
    "requires": "any"
  }],
  "fileSystems": [{
    "id": "departures",
    "name": "Tabule odjezdů SprŽel",
    "icon": "icon.svg",
    "iconDark": "icon.svg",
    "spinner": true,
    "listHandler": "listDepartures",
    "refreshIntervalMs": 30000,
    "refreshDepth": 1,
    "columns": [
      {"id": "train", "name": "Vlak", "width": 100},
      {"id": "trainNumber", "name": "Číslo vlaku", "width": 70, "numeric": true},
      {"id": "departureTime", "name": "Odjezd", "width": 100},
      {"id": "delay", "name": "Zpoždění", "width": 70, "numeric": true},
      {"id": "actualDepartureTime", "name": "Skutečný odjezd", "width": 100},
      {"id": "platform", "name": "Nástupiště", "width": 70, "numeric": true},
      {"id": "track", "name": "Kolej", "width": 60, "numeric": true},
      {"id": "sector", "name": "Sektor", "width": 70},
      {"id": "operator", "name": "Dopravce", "width": 80}
    ],
    "actions": [{
      "id": "viewDeparture",
      "title": "Zobrazit detaily odjezdu",
      "handler": "viewDeparture",
      "default": true,
      "itemIdPrefix": "dep-"
    }]
  }]
}
