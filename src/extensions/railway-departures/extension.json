{
  "schema": 2,
  "id": "TabuleSprZel",
  "name": "Tabule SprŽel",
  "version": "1.6.0",
  "description": "Scrapes railway departures from Správy Železnic website and displays them in Salamander file-system panel.",
  "runtime": "JavaScript.Node",
  "entryPoint": "main.mjs",
  "web": "https://krtkovo.eu/sprzel/",
  "security": {
    "networkAccess": "yes",
    "externalProcesses": "yes",
    "scriptExecution": "yes",
    "activeWebContent": "yes",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "file-system",
    "panels.write",
    "ui.dialogs",
    "storage",
    "commands",
    "events"
  ],
  "viewers": [
    {
      "name": "Departure Details",
      "patterns": [
        "*.departure"
      ],
      "handler": "viewDeparture"
    }
  ],
  "events": ["hostStartup"],
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json"
  },
  "commands": [
    {
      "id": "TabuleSprZel.open",
      "title": "Open SprŽel Departures Board",
      "path": "salamatrix:TabuleSprZel!departures",
      "menu": "both",
      "contextMenu": false,
      "toolbar": true,
      "requires": "any",
      "toolbarMenu": true
    },
    {
      "id": "TabuleSprZel.configure",
      "title": "Configuration",
      "handler": "configureUrl",
      "menu": "both",
      "contextMenu": false,
      "toolbar": false,
      "requires": "any"
    },
    {
      "id": "TabuleSprZel.favorites",
      "title": "⭐Favorite Stations",
      "path": "salamatrix:TabuleSprZel!departures/_favorites",
      "menu": "both",
      "contextMenu": false,
      "toolbar": false,
      "requires": "any"
    }
  ],
  "fileSystems": [
    {
      "id": "departures",
      "name": "SprŽel Departures Board",
      "icon": "icon.svg",
      "iconDark": "icon.svg",
      "spinner": true,
      "listHandler": "listDepartures",
      "openHandler": "viewStationBoard",
      "refreshDepth": 2,
      "rootItems": [
        { "id": "_favorites", "name": "_favorites", "icon": "icons/favorites.svg", "iconDark": "icons/favorites-dark.svg" },
        { "id": "A", "name": "A", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "B", "name": "B", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "C", "name": "C", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "D", "name": "D", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "E", "name": "E", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "F", "name": "F", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "G", "name": "G", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "H", "name": "H", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "CH", "name": "CH", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "I", "name": "I", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "J", "name": "J", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "K", "name": "K", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "L", "name": "L", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "M", "name": "M", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "N", "name": "N", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "O", "name": "O", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "P", "name": "P", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "R", "name": "R", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "S", "name": "S", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "T", "name": "T", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "U", "name": "U", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "V", "name": "V", "icon": "icon.svg", "iconDark": "icon.svg" },
        { "id": "Z", "name": "Z", "icon": "icon.svg", "iconDark": "icon.svg" }
      ],
      "columns": [
        {
          "id": "train",
          "name": "Train",
          "width": 100
        },
        {
          "id": "trainNumber",
          "name": "Train No.",
          "width": 70,
          "numeric": true
        },
        {
          "id": "departureTime",
          "name": "Departure",
          "width": 100
        },
        {
          "id": "delay",
          "name": "Delay",
          "width": 70,
          "numeric": true
        },
        {
          "id": "actualDepartureTime",
          "name": "Actual Departure",
          "width": 100
        },
        {
          "id": "platform",
          "name": "Platform",
          "width": 70,
          "numeric": true
        },
        {
          "id": "track",
          "name": "Track",
          "width": 60,
          "numeric": true
        },
        {
          "id": "sector",
          "name": "Sector",
          "width": 70
        },
        {
          "id": "line",
          "name": "Line",
          "width": 70
        },
        {
          "id": "destination",
          "name": "Destination",
          "width": 180
        },
        {
          "id": "via",
          "name": "Via",
          "width": 240
        },
        {
          "id": "operator",
          "name": "Carrier",
          "width": 80
        },
        {
          "id": "note",
          "name": "Note",
          "width": 300
        }
      ],
      "actions": [
        {
          "id": "viewDeparture",
          "title": "Show departure details",
          "handler": "viewDeparture",
          "default": true,
          "itemIdPrefix": "dep-"
        },
        {
          "id": "viewStationBoard",
          "title": "Show station departures",
          "handler": "viewStationBoard",
          "itemIdPrefix": "stn-",
          "refresh": false
        }
      ]
    }
  ]
}
